

<mjml>
  <mj-head>
    <mj-font name="Open Sans" href="https://fonts.googleapis.com/css?family=Open+Sans:400,700" />
    <mj-attributes>
      <mj-all font-family="Open Sans, Arial, sans-serif" />
      <mj-class name="headline-text"
        font-family="Big Caslon, Garamond, Times, serif"
        color="#1a56db"
        font-size="30px"
        line-height="40px"
        align="center"
        text-transform="uppercase" />
      <mj-class name="body-text"
        font-family="Open Sans, Arial, sans-serif"
        color="#111111"
        font-size="16px"
        line-height="26px"
        align="center" />
      <mj-class name="signoff"
        font-family="Open Sans, Arial, sans-serif"
        color="#111111"
        font-size="16px"
        line-height="26px"
        align="left" />
    </mj-attributes>
    <mj-style>
      .greeting { font-size: 18px; color: #232323; text-align: center; font-weight: 600; padding: 24px 0 0 0; }
      .headline-padding { padding: 150px 0 0 0; }
      .after-headline-padding { padding: 0 0 150px 0; }
      .after-body-padding { padding: 0 0 150px 0; }
      .disclaimer { font-size: 10px; color: #111; text-align: center; line-height: 15px; margin: 0 auto; padding: 250px 0 8px 0;}
      .footer-info { font-size: 10px; color: #111; text-align: center; line-height: 15px; margin: 0 auto; }
    </mj-style>
    <mj-style>
      @media all and (max-width: 600px) {
        .mj-column-per-100 { width:100%!important; }
        .mj-column-per-90 { width:90%!important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f9f9f9">
    <mj-section background-color="#f9f9f9" padding="0" width="100%">
      <mj-column width="500px" padding="0" vertical-align="top">
        <mj-text css-class="greeting" padding="24px 0 0 0">
          Hi {{name}},
        </mj-text>
        <mj-text mj-class="headline-text" css-class="headline-padding">
          We are excited<br />to<br />connect with you.
        </mj-text>
        <mj-text mj-class="body-text" css-class="after-headline-padding">
          Thank you for contacting us.<br/>
          Our team will review your message and get back to you as soon as possible.
        </mj-text>
        <mj-text mj-class="signoff" css-class="after-body-padding">
          Best wishes,<br/>
          The myprojectRunway Team
        </mj-text>
        <!-- Divider for separation -->
        <mj-divider border-color="#ececec" border-width="1px" padding="40px 0 20px 0"/>
        <!-- Disclaimer -->
        <mj-raw>
          <p style="margin:0 auto; padding-bottom:10px; font-size:10px; line-height:15px; color:#111111; font-family: 'Open Sans', 'Raleway', Arial, Helvetica, sans-serif; text-align:center; max-width:500px;">
            We only send emails to individuals who have registered at our site:
            <a href="https://myprojectrunway.com" name="footer_ugghomepage" style="color:#111111; text-decoration:underline;">myprojectRunway.com</a>
          </p>
        </mj-raw>
        <!-- Footer Info -->
        <mj-raw>
          <p style="margin:0 auto; padding-bottom:10px; font-size:10px; line-height:15px; color:#111111; font-family: 'Open Sans', 'Raleway', Arial, Helvetica, sans-serif; text-align:center; max-width:500px;">
            <span style="color:#111111 !important; text-decoration:none;">
              <strong>myprojectRunway</strong><br />
              427 Teheran-ro, Gangnam District<br />
              Seoul, South Korea<br />
              Email: <a href="mailto:info@myprojectRunway.com" style="color:#111111;text-decoration:none;">info@myprojectRunway.com</a><br/>
              Phone: <a href="tel:+821022755951" style="color:#111111;text-decoration:none;">+82 10 2275 5951</a><br/>
              <a href="https://myprojectrunway.com/privacy" style="color:#111111; text-decoration:underline;">Privacy Policy</a> &nbsp;|&nbsp;
              <a href="https://myprojectrunway.com/unsubscribe" style="color:#111111; text-decoration:underline;">Unsubscribe</a>
            </span>
          </p>
        </mj-raw>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
